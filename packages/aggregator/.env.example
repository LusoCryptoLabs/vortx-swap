# Aggregator environment (copy to .env or export before `npx tsx src/main.ts`)

# Which network the aggregator serves.
NETWORK=testnet

# Solver/keeper key (required). Funds OTX settlement and limit-order fills.
SOLVER_PRIVATE_KEY=0x...

# HTTP ports.
OTX_PORT=3002
HEALTH_PORT=3001

# Browser origin allowed to call the server (default: *).
CORS_ORIGIN=*
