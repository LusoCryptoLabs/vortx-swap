# CellSwap environment template
# Copy to .env and fill in values. Never commit .env.

# Network: devnet | testnet | mainnet
NETWORK=devnet

# CKB RPC (devnet default from offckb)
CKB_RPC_URL=http://127.0.0.1:28114
INDEXER_URL=http://127.0.0.1:8116

# Aggregator solver key (testnet/mainnet only; use a hardware key for mainnet)
SOLVER_PRIVATE_KEY=

# Protocol fee multisig address (3-of-5, required before mainnet)
PROTOCOL_FEE_ADDRESS=

# Testnet faucet: https://faucet.nervos.org
# Need Aggron CKB before any contract deployment

# Optional: override RPC for specific packages
# AGGREGATOR_CKB_RPC_URL=
# SDK_DEFAULT_RPC_URL=

# ── Aggregator HTTP hardening ──────────────────────────────────────────────────
# All opt-in: unset means permissive dev defaults (the server logs a warning at startup).
# CORS allowlist: comma-separated origins. Set to your frontend origin in production.
# Leave unset / "*" only for local dev.
CORS_ORIGIN=
# Behind a TLS-terminating reverse proxy, set to 1 so rate limiting keys on the real
# client IP (X-Forwarded-For) instead of the proxy's address.
TRUST_PROXY=
# If set, the detailed GET /orders listing requires this key (Bearer or X-API-Key header).
# Generate with: openssl rand -hex 32
AGGREGATOR_API_KEY=
# Native TLS: set both to serve HTTPS directly (otherwise terminate TLS at a proxy, see Caddyfile).
TLS_CERT_PATH=
TLS_KEY_PATH=
# Bound the in-memory OTX settlement queue (default 5000).
MAX_OTX_QUEUE=5000

# ── VTX buy-back-and-burn keeper ───────────────────────────────────────────────
# Used by scripts/buyback-keeper-testnet.mjs (one cycle) and scripts/buyback-keeper-loop.mjs
# (one cycle every VTX_KEEPER_INTERVAL_EPOCHS epochs). Team compensation is funded from fees, not a
# pre-mine, and capped at 25% of the 1/6 protocol cut. The team's share splits two ways; the
# remainder is burned. Intended split: ⅓ liquid CKB (833bps) + ⅔ vested VTX (1667bps). Both default
# to 0 (everything is burned) until you set them. VTX_TEAM_CKB_BPS + VTX_TEAM_VEST_BPS must be <= 2500.
#
# Liquid CKB slice, bps of each cycle's revenue. Intended: 833.
VTX_TEAM_CKB_BPS=0
# Team-treasury address for the CKB slice. Required when VTX_TEAM_CKB_BPS > 0. It must be a dedicated
# treasury separate from the keeper/governance key (team payments must not share a key with
# emission/pause control). The keeper refuses to pay the slice to the deployer.
VTX_TEAM_CKB_ADDR=
# Vested VTX slice, bps of each cycle's revenue. Intended: 1667.
VTX_TEAM_VEST_BPS=0
# Team owner lock hash for the vested-VTX timelock. Required when VTX_TEAM_VEST_BPS > 0.
# VTX_TEAM_LOCK=
# Epochs until each vested VTX tranche unlocks (default 180 ≈ 30 days @ ~4h/epoch). A vesting ladder =
# repeated cycles; for a 24-36mo ladder stagger this across runs.
# VTX_VEST_EPOCHS=180
# CKB of redeemed fee revenue to deploy per cycle (default 50).
VTX_FEE_BUDGET_CKB=50
# Autonomous loop cadence: run one cycle every N epochs (default 6 ≈ 1 day @ ~4h/epoch).
VTX_KEEPER_INTERVAL_EPOCHS=6
