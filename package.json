{
  "name": "cellswap",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test --if-present && node scripts/run-logic-tests.mjs",
    "dev": "pnpm --filter @cellswap/aggregator dev",
    "contracts:build": "make build",
    "contracts:test": "make test",
    "codegen": "bash scripts/codegen.sh",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint --if-present",
    "clean": "pnpm -r clean && cd contracts && cargo clean"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.12.5",
    "@joyid/ckb": "^1.1.4",
    "@cellswap/sdk": "workspace:*",
    "@cellswap/config": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
